{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "WebFetch",
      "WebSearch",
      "Skill(*)",
      "mcp__ide__getDiagnostics",
      "mcp__mcp-omnisearch__github_search",
      "mcp__mcp-omnisearch__firecrawl_process",
      "mcp__mcp-omnisearch__web_search",
      "mcp__mcp-omnisearch__tavily_extract_process",
      "mcp__mcp-omnisearch__kagi_summarizer_process",
      "mcp__mcp-omnisearch__ai_search",
      "mcp__mcp-omnisearch__kagi_enrichment_enhance",
      "mcp__mcp-sqlite-tools__open_database",
      "mcp__mcp-sqlite-tools__list_tables",
      "mcp__mcp-sqlite-tools__list_databases",
      "mcp__mcp-sqlite-tools__describe_table",
      "mcp__mcp-sqlite-tools__execute_read_query",
      "Bash(bun:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(bunx:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(claude:*)",
      "Bash(bash:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git worktree:*)",
      "Bash(git clone:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push origin:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git reset:*)",
      "Bash(git -C:*)",
      "Bash(gh:*)",
      "Bash(docker:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(tree:*)",
      "Bash(test:*)",
      "Bash(xargs:*)",
      "Bash(echo:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(lsof:*)",
      "Bash(pkill:*)",
      "Bash(timeout:*)",
      "Bash(prettier:*)",
      "Bash(yes:*)",
      "Bash(paste:*)",
      "Bash(bc:*)",
      "Bash(yt-dlp:*)",
      "Bash(systemctl is-active:*)",
      "Bash(CI=true:*)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(cat .env)",
      "Bash(sqlite3:*)",
      "Bash(git push origin main*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ],
    "ask": [
      "Bash(rm:*)"
    ],
    "defaultMode": "default"
  },
  "enabledPlugins": {
    "svelte-skills@svelte-skills-kit": true,
    "analytics@claude-code-toolkit": true,
    "mcp-essentials@claude-code-toolkit": true,
    "performance@claude-code-toolkit": true,
    "toolkit-skills@claude-code-toolkit": true,
    "ralph-town@ralph-town-marketplace": true
  },
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest"
}
